---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentCard from '../../components/ContentCard.astro';
import {
  contentSections,
  rankRelatedContent,
  toContentCard,
  type ContentKind,
} from '../../lib/content';
import { getPublishedEntries, toSummary, type SiteEntry } from '../../lib/site-data';

export async function getStaticPaths() {
  const entries = await getPublishedEntries();
  return entries.map((entry) => ({
    params: {
      section: contentSections[entry.data.kind],
      slug: entry.data.slug,
    },
    props: { entry, allEntries: entries },
  }));
}

interface RouteProps {
  entry: SiteEntry;
  allEntries: readonly SiteEntry[];
}

const { entry, allEntries } = Astro.props as RouteProps;
const { Content } = await render(entry);
const summary = toSummary(entry);
const summaries = allEntries.map(toSummary);
const related = rankRelatedContent(summary, summaries);
const baseUrl = import.meta.env.BASE_URL;
const publishedLabel = entry.data.published.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
const section = contentSections[entry.data.kind as ContentKind];
---

<BaseLayout title={entry.data.title} description={entry.data.description} noindex={entry.data.noindex}>
  <article class="article-shell shell">
    <header class="article-header">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href={baseUrl}>Entif AI</a>
        <span aria-hidden="true">/</span>
        <a href={`${baseUrl}${section}/`}>{section}</a>
      </nav>
      <p class="eyebrow">{entry.data.kind} · {publishedLabel}</p>
      <h1>{entry.data.title}</h1>
      <p class="lede">{entry.data.description}</p>
      {entry.data.tags.length > 0 && (
        <ul class="tag-list article-tags" aria-label="Topics">
          {entry.data.tags.map((tag) => (
            <li><a href={`${baseUrl}topics/${tag}/`}>{tag}</a></li>
          ))}
        </ul>
      )}
    </header>

    <div class="article-grid">
      <div class="article-body prose">
        <Content />
      </div>
      <aside class="article-aside" aria-label="Article metadata">
        <p class="eyebrow">Repository-native</p>
        <p>
          This page is generated from reviewed Markdown. Its public history travels with
          the Rosetta repository.
        </p>
        <dl>
          <div><dt>Content ID</dt><dd>{entry.data.id}</dd></div>
          <div><dt>Status</dt><dd>{entry.data.status}</dd></div>
          <div><dt>Authors</dt><dd>{entry.data.authors.join(', ')}</dd></div>
        </dl>
      </aside>
    </div>
  </article>

  {related.length > 0 && (
    <section class="section shell related-section" aria-labelledby="related-heading">
      <div class="section-heading narrow">
        <div>
          <p class="eyebrow">Semantic neighbors</p>
          <h2 id="related-heading">Continue through the lattice.</h2>
        </div>
      </div>
      <div class="card-grid">
        {related.map((item) => <ContentCard card={toContentCard(item, baseUrl)} />)}
      </div>
    </section>
  )}
</BaseLayout>
