---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentCard from '../../components/ContentCard.astro';
import {
  contentSections,
  toContentCard,
  type ContentKind,
} from '../../lib/content';
import {
  getPublishedEntries,
  toSummary,
  type SiteEntry,
} from '../../lib/site-data';

export async function getStaticPaths() {
  const entries = await getPublishedEntries();
  const bySection = new Map<string, SiteEntry[]>();

  for (const entry of entries) {
    const section = contentSections[entry.data.kind as ContentKind];
    bySection.set(section, [...(bySection.get(section) ?? []), entry]);
  }

  return [...bySection.entries()].map(([section, sectionEntries]) => ({
    params: { section },
    props: { section, entries: sectionEntries },
  }));
}

interface RouteProps {
  section: string;
  entries: readonly SiteEntry[];
}

const { section, entries } = Astro.props as RouteProps;
const baseUrl = import.meta.env.BASE_URL;
const summaries = entries.map(toSummary);
---

<BaseLayout
  title={section}
  description={`Published Entif AI ${section} pages from the Rosetta repository.`}
>
  <section class="section shell topic-page">
    <p class="eyebrow">Collection</p>
    <h1>{section}</h1>
    <p class="lede">
      {summaries.length} published {summaries.length === 1 ? 'page' : 'pages'}.
    </p>
    <div class="card-grid">
      {
        summaries.map((item) => (
          <ContentCard card={toContentCard(item, baseUrl)} />
        ))
      }
    </div>
  </section>
</BaseLayout>
