---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { TopicExplorer } from '../components/TopicExplorer';
import { getContentPath, joinBasePath, toContentCard } from '../lib/content';
import { getPublishedEntries, toSummary } from '../lib/site-data';

const entries = await getPublishedEntries();
const summaries = entries.map(toSummary);
const baseUrl = import.meta.env.BASE_URL;
const cards = summaries.map((item) => toContentCard(item, baseUrl));
const featured = entries.find(({ data }) => data.featured) ?? entries[0];
const featuredSummary =
  featured === undefined ? undefined : toSummary(featured);
const homepage = await getEntry('pages', 'home');

if (homepage === undefined || homepage.data.status !== 'published') {
  throw new Error('Published homepage content is missing.');
}

const { Content: HomepagePrinciples } = await render(homepage);
---

<BaseLayout
  title="Entif AI"
  description="Entif AI develops Rosetta: open research into machine-readable meaning, provenance, memory, and governed agentic systems."
>
  <section class="hero shell" data-test-id="home-hero">
    <div class="hero-copy">
      <p class="eyebrow">Entif AI · Open research</p>
      <h1 data-test-id="home-hero-heading">
        Meaning should survive the machine that reasons over it.
      </h1>
      <p class="lede">
        Entif AI develops Rosetta, an open research and engineering program for
        semantic representation, provenance, memory, and governed agentic
        systems.
      </p>
      <div class="hero-actions">
        <a
          class="button primary"
          href="#research"
          data-test-id="home-explore-research">Explore the research</a
        >
        <a
          class="button secondary"
          href={joinBasePath(baseUrl, 'projects/rosetta/')}
          data-test-id="home-meet-rosetta">Meet Rosetta</a
        >
      </div>
    </div>
    <div class="hero-mark" aria-hidden="true">
      <div class="logo-frame">
        <img
          src={joinBasePath(baseUrl, 'brand/entif-logo.webp')}
          width="320"
          height="320"
          alt=""
          decoding="async"
          fetchpriority="high"
          data-test-id="home-hero-logo"
        />
      </div>
      <span class="signal signal-a"></span>
      <span class="signal signal-b"></span>
      <span class="signal signal-c"></span>
    </div>
  </section>

  <section class="signal-strip" aria-label="Entif research focus">
    <div class="shell signal-grid">
      <p><strong>Represent</strong><span>meaning explicitly</span></p>
      <p><strong>Remember</strong><span>with provenance</span></p>
      <p><strong>Reason</strong><span>across bounded context</span></p>
      <p><strong>Govern</strong><span>before mutation</span></p>
    </div>
  </section>

  <section
    class="section shell"
    id="principles"
    aria-labelledby="principles-heading"
    data-test-id="home-philosophy"
  >
    <div class="section-heading">
      <div>
        <p class="eyebrow">{homepage.data.eyebrow}</p>
        <h2 id="principles-heading" data-test-id="home-philosophy-heading">
          {homepage.data.title}
        </h2>
      </div>
      <p>{homepage.data.description}</p>
    </div>
    <div class="home-principles-body prose" data-test-id="home-philosophy-body">
      <HomepagePrinciples />
    </div>
  </section>

  <section class="section shell" id="research" data-test-id="home-research">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Research lattice</p>
        <h2 id="research-heading">Ideas that connect instead of pile up.</h2>
      </div>
      <p>
        Public pages are compiled from Markdown in the Rosetta repository and
        linked by shared projects and topics at build time.
      </p>
    </div>
    <TopicExplorer cards={cards} client:load />
  </section>

  {
    featured && featuredSummary && (
      <section class="feature-band" data-test-id="home-featured-work">
        <div class="shell feature-layout">
          <div>
            <p class="eyebrow">Current thread</p>
            <h2>{featured.data.title}</h2>
          </div>
          <div>
            <p>{featured.data.description}</p>
            <a
              class="text-link"
              href={joinBasePath(baseUrl, getContentPath(featuredSummary))}
              data-test-id="home-featured-link"
            >
              Read the work <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>

<style is:global>
  .home-principles-body {
    max-width: var(--reading);
  }

  .home-principles-body blockquote {
    margin-top: 2.5rem;
  }
</style>
