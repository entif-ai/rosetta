---
import ContentCard from '../../components/ContentCard.astro';
import ContentPageLayout from '../../layouts/ContentPageLayout.astro';
import { toContentCard } from '../../lib/content';
import { getPublishedEntries, toSummary } from '../../lib/site-data';

const baseUrl = import.meta.env.BASE_URL;
const projects = (await getPublishedEntries())
  .filter(({ data }) => data.kind === 'project')
  .map(toSummary);
---

<ContentPageLayout
  title="Projects"
  description="Browse Entif AI projects and the research programs organized around them."
  eyebrow="Programs"
  heading="Projects"
  lede="Project pages provide stable homes for Entif research and engineering programs."
>
  <div class="card-grid" data-test-id="projects-page-grid">
    {
      projects.map((item) => (
        <ContentCard card={toContentCard(item, baseUrl)} />
      ))
    }
  </div>
</ContentPageLayout>
