{
  "name": "@entif-ai/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "api": "pnpm exec nx serve rosetta-api",
    "build": "NX_DAEMON=false pnpm exec nx sync && NX_DAEMON=false pnpm exec nx run-many -t build --exclude @entif-ai/source --skip-nx-cache --parallel=1",
    "demo": "pnpm exec nx sync && pnpm exec nx build rosetta-cli && node apps/rosetta-cli/dist/main.js",
    "docs:intake": "node tools/doc-intake/build-doc-intake.mjs",
    "graph": "pnpm exec nx graph",
    "lint": "pnpm exec eslint .",
    "sync": "NX_DAEMON=false pnpm exec nx sync",
    "test": "pnpm exec vitest run",
    "typecheck": "NX_DAEMON=false pnpm exec nx sync && NX_DAEMON=false pnpm exec nx run-many -t typecheck --exclude @entif-ai/source",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build",
    "prepare": "husky"
  },
  "private": true,
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^8.57.0",
    "@nx/esbuild": "22.6.5",
    "@nx/eslint": "22.6.5",
    "@nx/js": "22.6.5",
    "@nx/node": "22.6.5",
    "@nx/react": "22.6.5",
    "@nx/vite": "22.6.5",
    "@nx/vitest": "22.6.5",
    "@nx/web": "22.6.5",
    "@react-router/dev": "7.12.0",
    "@swc-node/register": "1.11.1",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.21",
    "@types/node": "^20.0.0",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.33.1",
    "@typescript-eslint/parser": "^8.33.1",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/coverage-v8": "4.1.4",
    "@vitest/ui": "4.1.4",
    "esbuild": "^0.19.2",
    "eslint": "~8.57.0",
    "husky": "^9.1.7",
    "jiti": "2.4.2",
    "jsdom": "~22.1.0",
    "nx": "22.6.5",
    "prettier": "^2.6.2",
    "tslib": "^2.3.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.33.1",
    "vite": "7.3.2",
    "vitest": "4.1.4"
  },
  "dependencies": {
    "@react-router/node": "7.12.0",
    "@react-router/serve": "7.12.0",
    "isbot": "^4.4.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-router": "7.12.0"
  }
}
