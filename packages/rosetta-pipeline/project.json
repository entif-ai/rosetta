{
  "name": "rosetta-pipeline",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/rosetta-pipeline/src",
  "projectType": "library",
  "tags": ["rosetta", "pipeline", "semantic"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/rosetta-pipeline",
        "command": "tsc --build tsconfig.lib.json"
      },
      "dependsOn": ["^build"],
      "cache": true,
      "outputs": [
        "{projectRoot}/dist/**/*.{js,cjs,mjs,jsx,d.ts,d.cts,d.mts}{,.map}",
        "{projectRoot}/dist/tsconfig.lib.tsbuildinfo"
      ]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/rosetta-pipeline",
        "command": "tsc --build tsconfig.lib.json --emitDeclarationOnly"
      },
      "dependsOn": [
        "^typecheck"
      ],
      "cache": true,
      "outputs": [
        "{projectRoot}/dist/**/*.d.ts",
        "{projectRoot}/dist/**/*.d.ts.map",
        "{projectRoot}/dist/tsconfig.lib.tsbuildinfo"
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "command": "vitest run packages/rosetta-pipeline/src/lib/rosetta-pipeline.spec.ts"
      },
      "cache": true,
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/vitest.config.ts",
        {
          "externalDependencies": [
            "vitest"
          ]
        }
      ],
      "outputs": [
        "{projectRoot}/coverage"
      ]
    }
  }
}
