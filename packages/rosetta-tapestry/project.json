{
  "name": "rosetta-tapestry",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/rosetta-tapestry/src",
  "projectType": "library",
  "tags": [],
  "// targets": "to see all targets run: nx show project rosetta-tapestry --web",
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "command": "vitest run packages/rosetta-tapestry/src/lib/rosetta-tapestry.spec.ts"
      },
      "cache": true,
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/vitest.config.ts",
        {
          "externalDependencies": [
            "vitest"
          ]
        }
      ],
      "outputs": [
        "{projectRoot}/coverage"
      ]
    }
  }
}
