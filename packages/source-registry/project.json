{
  "name": "source-registry",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/source-registry/src",
  "projectType": "library",
  "tags": [],
  "// targets": "to see all targets run: nx show project source-registry --web",
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "command": "vitest run packages/source-registry/src/lib/source-registry.spec.ts"
      },
      "cache": true,
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/vitest.config.ts",
        {
          "externalDependencies": [
            "vitest"
          ]
        }
      ],
      "outputs": [
        "{projectRoot}/coverage"
      ]
    }
  }
}
