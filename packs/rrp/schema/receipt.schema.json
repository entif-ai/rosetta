{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://entif.ai/packs/rrp/schema/receipt.schema.json",
  "title": "RRP Receipt Payload",
  "type": "object",
  "required": ["claims", "digests", "policyRefs", "receiptType", "subjects"],
  "properties": {
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claimType", "evidence", "statement", "verdict"],
        "properties": {
          "claimType": { "type": "string" },
          "confidence": { "type": "number" },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["cid"],
              "properties": {
                "cid": { "type": "string" },
                "span": { "type": "string" }
              },
              "additionalProperties": false
            }
          },
          "statement": { "type": "string" },
          "verdict": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "digests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["alg", "digest", "of"],
        "properties": {
          "alg": { "type": "string" },
          "cidRef": { "type": "string" },
          "digest": { "type": "string" },
          "of": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "policyRefs": { "type": "array", "items": { "type": "string" } },
    "receiptType": { "type": "string" },
    "subjects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["cid"],
        "properties": {
          "cid": { "type": "string" },
          "role": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
