{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://entif.ai/schema/pack-manifest.schema.json",
  "title": "Entif Pack Manifest",
  "type": "object",
  "required": ["id", "kind", "version", "title", "entrypoints"],
  "properties": {
    "id": { "type": "string" },
    "kind": {
      "type": "string",
      "enum": ["pack", "stdpack", "vocabpack", "schema-pack"]
    },
    "version": { "type": "string" },
    "title": { "type": "string" },
    "summary": { "type": "string" },
    "entrypoints": {
      "type": "object",
      "properties": {
        "examples": { "type": "array", "items": { "type": "string" } },
        "schema": { "type": "array", "items": { "type": "string" } },
        "shacl": { "type": "array", "items": { "type": "string" } },
        "tests": { "type": "array", "items": { "type": "string" } },
        "vocab": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "dependsOn": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
