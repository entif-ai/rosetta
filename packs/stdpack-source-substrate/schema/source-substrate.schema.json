{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://entif.ai/packs/stdpack-source-substrate/schema/source-substrate.schema.json",
  "title": "Source Substrate Starter Shapes",
  "type": "object",
  "properties": {
    "sourceSystemProfile": {
      "type": "object",
      "required": ["canonicalName", "capabilityFacets", "curationPosture", "evidenceRefs", "rightsPosture", "sourceRoles", "sourceSystemId"]
    },
    "sourceRecord": {
      "type": "object",
      "required": ["metadataBlob", "publicationStatus", "recordLocalId", "recordType", "sourceSystemId", "stableLocators"]
    },
    "sourceManifestation": {
      "type": "object",
      "required": ["accessRequirements", "byteHashes", "manifestationId", "manifestationKind", "mediaType", "sourceRecordCid", "structureProfile"]
    },
    "trustMatrix": {
      "type": "object",
      "required": ["axes", "notes", "subjectCid", "trustClass"]
    },
    "fetchReceipt": {
      "type": "object",
      "required": ["fetchedAt", "method", "requestedLocator", "resolvedLocator", "snapshotHash", "sourceManifestationCid"]
    },
    "normalizationReceipt": {
      "type": "object",
      "required": ["canonicalTextHash", "contentFingerprint", "normalizationProfile", "parserProfile", "revisionFingerprint", "sourceManifestationCid"]
    },
    "evaluationReceipt": {
      "type": "object",
      "required": ["evaluatedAt", "policyRefs", "subjectCid", "trustMatrixCid"]
    },
    "canonicalArtifact": {
      "type": "object",
      "required": [
        "artifactId",
        "byteHash",
        "contentFingerprint",
        "dedupe",
        "normalizedText",
        "normalizedTextHash",
        "pidFamily",
        "provenanceRefs",
        "revisionFingerprint",
        "rightsScopes",
        "sourceManifestationCid",
        "sourceRecordCid"
      ]
    },
    "derivedArtifact": {
      "type": "object",
      "required": ["artifactId", "derivationKind", "payloadText", "sourceObservationCid", "sourceSpans"]
    }
  },
  "additionalProperties": false
}
